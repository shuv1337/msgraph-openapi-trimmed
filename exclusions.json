  "excludeOperations": [
    {
      "why": "Returns a new Temporary Access Pass in the response, which would put the pass in the agent's context. manage.security.restoreAccount issues passes as one-time links instead.",
      "operations": [
        {
          "method": "post",
          "path": "/users/{user-id}/authentication/temporaryAccessPassMethods"
        }
      ]
    }
  ]
