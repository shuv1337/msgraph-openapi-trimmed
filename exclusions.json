{
  "source": {
    "repository": "microsoftgraph/msgraph-metadata",
    "commit": "19426105dd741181fffcd4972c8800b569360bed",
    "path": "openapi/v1.0/openapi.yaml"
  },
  "exclude": [
    {
      "why": "Needs a signed-in user; this spec serves app-only callers",
      "patterns": [
        "^/me(/|$|\\()",
        "filterByCurrentUser\\(on="
      ]
    },
    {
      "why": "List operations accept $count",
      "patterns": [
        "/\\$count$"
      ]
    },
    {
      "why": "Excel cell, chart and table editing; no admin use",
      "patterns": [
        "/workbook(?=/|\\(|$)"
      ]
    },
    {
      "why": "Copies of /sites and /teams, which remain",
      "patterns": [
        "^/groups/\\{group-id\\}/sites/\\{site-id\\}(/|$)",
        "^/groups/\\{group-id\\}/team/",
        "^/teams/\\{team-id\\}/primaryChannel/"
      ]
    },
    {
      "why": "OneNote editing; no admin use",
      "patterns": [
        "^/groups/\\{group-id\\}/onenote(/|$)",
        "^/sites/\\{site-id\\}(/getByPath\\(path='\\{path\\}'\\))?/onenote(/|$)",
        "^/users/\\{user-id\\}/onenote(/|$)"
      ]
    },
    {
      "why": "Plural copy of the default termStore paths, which remain",
      "patterns": [
        "^/sites/\\{site-id\\}(/getByPath\\(path='\\{path\\}'\\))?/termStores(/|$)"
      ]
    },
    {
      "why": "Nested entitlement management copies; top-level paths remain",
      "patterns": [
        "^/identityGovernance/entitlementManagement/.*/resource/",
        "^/identityGovernance/entitlementManagement/resourceRequests/\\{[^}]+\\}/catalog/",
        "^/identityGovernance/entitlementManagement/(catalogs|resourceEnvironments)/\\{[^}]+\\}/resources/\\{[^}]+\\}/(roles|scopes|uploadSessions|environment|externalOriginResourceConnector|refresh)(/|$)",
        "^/identityGovernance/catalogs(/|$)"
      ]
    },
    {
      "why": "Nested lifecycle workflow copies; canonical task paths remain",
      "patterns": [
        "^/identityGovernance/lifecycleWorkflows/.*/taskProcessingResults/\\{taskProcessingResult-id\\}/(subject|task)(/|$)",
        "^/identityGovernance/lifecycleWorkflows/.*/taskReports/\\{taskReport-id\\}/(task|taskDefinition|taskProcessingResults)(/|$)"
      ]
    },
    {
      "why": "Deep user navigation; read the id, then use /users/{id}",
      "patterns": [
        "/(createdByUser|lastModifiedByUser)(/|$)",
        "/(createdBy|lastModifiedBy)/"
      ]
    },
    {
      "why": "Out of scope for tenant administration",
      "patterns": [
        "^/education(/|$)",
        "^/employeeExperience(/|$)",
        "^/users/\\{user-id\\}/employeeExperience(/|$)",
        "^/users/\\{user-id\\}/(todo|activities|insights|cloudClipboard)(/|$)"
      ]
    },
    {
      "why": "Retired, deprecated or separately licensed",
      "patterns": [
        "^/deviceAppManagement/(mdm)?[Ww]indowsInformationProtectionPolicies|^/deviceManagement/windowsInformationProtection(AppLearning|NetworkLearning)Summaries",
        "^/security/threatIntelligence/(articles|articleIndicators)(/|$)",
        "^/security/alerts(/|$)",
        "^/reports/getSkypeForBusiness",
        "^/identityProviders(/|$)"
      ]
    },
    {
      "why": "Aliases of paths that remain",
      "patterns": [
        "^/policies/conditionalAccessPolicies(/|$)",
        "^/identity/conditionalAccess/authenticationStrength/policies(/|$)",
        "^/users\\(userPrincipalName=",
        "^/devices\\(deviceId=",
        "/assignedUsers\\(userPrincipalName=",
        "^/deviceAppManagement/mobileApps/graph\\.",
        "^/admin/serviceAnnouncement/healthOverviews/\\{serviceHealth-id\\}/issues(/|$)"
      ]
    }
  ],
